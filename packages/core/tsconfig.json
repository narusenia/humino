{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["esnext"],
    "types": []
  },
  "include": ["src/**/*", "test/**/*"]
}
